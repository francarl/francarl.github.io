{
  "name": "Video Player",
  "short_name": "VideoPlayer",
  "description": "Carica e riproduci video con Video.js",
  "start_url": "/index.html",
  "display": "standalone",
  "background_color": "#000000",
  "theme_color": "#000000",
  "icons": [
    {
      "src": "/icon-192.svg",
      "sizes": "192x192",
      "type": "image/svg+xml",
      "purpose": "any maskable"
    },
    {
      "src": "/icon-512.svg",
      "sizes": "512x512",
      "type": "image/svg+xml",
      "purpose": "any maskable"
    }
  ],
  "file_handlers": [
    {
      "action": "/index.html",
      "accept": {
        "video/*": [".mp4", ".webm", ".ogg", ".mkv", ".avi", ".mov", ".flv", ".wmv", ".m4v", ".3gp"]
      }
    }
  ],
  "launch_handler": {
    "client_mode": "focus-existing"
  }
}
